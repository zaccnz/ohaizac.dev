---
import Layout from "@components/layout/Layout.astro";
import ProjectList from "@components/project/ProjectList.astro";
import { getCollection } from "astro:content";

const allProjects = await getCollection("projects");
const featuredProjects = allProjects
  .filter((project) => project.data.featured !== undefined)
  .map((project) => [project, project.data.featured ?? -1] as const)
  .sort(([_, left], [__, right]) => left - right)
  .map(([project, _]) => project);
---

<Layout title="featured projects">
  <h3>featured projects</h3>
  <ProjectList projects={featuredProjects} />
  <p><a href="/projects/all">view all</a></p>
</Layout>
