---
import Layout from "@components/layout/Layout.astro";
import ProjectList from "@components/project/ProjectList.astro";
import { getFilteredProjects, getAllFilterValues } from "@utils/projects";

export async function getStaticPaths() {
  return (await getAllFilterValues()).map((params) => ({ params }));
}

const { filter, value } = Astro.params;
const filteredProjects = await getFilteredProjects(filter, value);
---

<Layout>
  <h3>projects by {filter}: {value}</h3>
  <ProjectList projects={filteredProjects} />
</Layout>
