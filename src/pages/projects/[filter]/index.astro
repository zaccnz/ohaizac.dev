---
// View a list of all filter values

import Layout from "@components/layout/Layout.astro";
import LinkList from "@components/LinkList.astro";
import { getFilterValues, FilterList } from "@utils/projects";

export function getStaticPaths() {
  return FilterList.map((filter) => ({
    params: {
      filter,
    },
  }));
}

const { filter } = Astro.params;

const links = Object.entries(await getFilterValues(filter)).map(
  ([label, count]) => ({
    label,
    href: `/projects/${filter}/${label}`,
    description: `(${count})`,
  }),
);

const filterLinks = FilterList.filter((v) => v !== filter).map((label) => ({
  label,
  href: `/projects/${label}`,
}));
---

<Layout>
  <h2>filters by {filter}</h2>
  <LinkList as="h3" links={links} sep />
  <LinkList links={filterLinks} title="or by" sep />
</Layout>
